# Twitch Developer Console: https://dev.twitch.tv/console/apps
# App-Typ: Confidential oder Public (PKCE). Für Desktop empfohlen: Public Client mit PKCE (kein Secret nötig).
#
# Redirect URI in der Twitch Console exakt eintragen:
#   http://localhost:3847/callback
#
TWITCH_CLIENT_ID=deine_client_id_hier

# Optional: nur nötig, wenn die Twitch-App als Confidential Client konfiguriert ist
# TWITCH_CLIENT_SECRET=dein_client_secret_hier

# Muss mit der Redirect URI in der Twitch Console übereinstimmen
TWITCH_REDIRECT_URI=http://localhost:3847/callback
