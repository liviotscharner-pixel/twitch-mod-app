# Twitch Developer Console: https://dev.twitch.tv/console/apps
#
# Public (Öffentlich): KEIN Client Secret – App nutzt Device Code Grant Flow.
# Confidential: TWITCH_CLIENT_SECRET setzen – App nutzt Authorization Code + PKCE.
#
# Redirect URI (nur für Confidential / PKCE) in der Twitch Console exakt eintragen:
#   http://localhost:3847/callback
#
TWITCH_CLIENT_ID=deine_client_id_hier

# Optional: nur bei Confidential Client nötig. Wenn gesetzt → PKCE-Flow.
# Wenn weggelassen → Device-Code-Flow (empfohlen für Public Desktop-Apps).
# TWITCH_CLIENT_SECRET=dein_client_secret_hier

# Muss mit der Redirect URI in der Twitch Console übereinstimmen (PKCE-Pfad)
TWITCH_REDIRECT_URI=http://localhost:3847/callback
